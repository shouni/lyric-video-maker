# ------------------------------------
# 1. Virtual environments and package management
# ------------------------------------

# virtual environment directories (common names)
.venv
venv
env
/venv/
/env/
/bin/
/include/
/lib/
/lib64/

# pip cache and log files
pip-log.txt
.pip_log

# Python package manager files
poetry.lock  # remove this line and commit it if you use Poetry

# Pipenv files (lock files are usually committed)
Pipfile.lock

# Conda environment directory
.conda

# ------------------------------------
# 2. Bytecode and temporary files
# ------------------------------------

# Python bytecode
*.pyc
__pycache__/
*.pyd
*.whl

# C/C++ extension build leftovers
*.so
*.o
*.dll

# dist/build/egg/ etc. (packaging)
dist/
build/
*.egg-info/
.eggs/

# ------------------------------------
# 3. Tests and docs
# ------------------------------------

# test coverage and caches
.coverage
.tox/
.pytest_cache/

# Sphinx build output
/docs/_build/

# ------------------------------------
# 4. OS / editor files
# ------------------------------------

# macOS
.DS_Store

# Vim
*~

# VS Code settings
.vscode/

# JetBrains IDEs (PyCharm, IntelliJ IDEA, ...)
.idea/

# database files
*.sqlite3
db.sqlite3

# log files
*.log
/logs/

# environment variables and secrets
.env
.flaskenv

# MY APP
/var/tmp/
*.iml

# input / output files (binaries, generated)
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
frames_tmp*/

# audio, video and generated subtitles
*.mp3
*.wav
*.m4a
*.mp4
*.mov
*.zip
*.ass

# beatmv: per-song settings (songs/) and the work directory (work/) are symlinks to another local location.
# No trailing / : with it, the pattern would not match a link (it is not a directory)
/songs
/work
# subtitles of the made-up test song (*.ass is ignored above, so bring it back)
!/tests/fixtures/**/*.ass
